---
import type { CodeLanguage } from 'astro';
import { Code } from 'astro/components';

interface Props {
  title: string;
  lang: CodeLanguage;
  code: string;
  [key: string]: any;
}

const { title, lang, code, ...rest } = Astro.props;
---

<div bg-gray-800 rounded-2 p-0>
  <p w-full h-7 m-0 text-center>{title}</p>
  <Code code={code} lang={lang} theme="vitesse-dark" {...rest} overflow="auto" m-0 w-full p-3 />
</div>
