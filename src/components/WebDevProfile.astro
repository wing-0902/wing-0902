---
import { Code } from 'astro/components';
import codeSnippet from '~/assets/profile.ts?raw';
---

<Code
  x-data
  x-init="$nextTick(() => { 
    $el.scrollTo({
      top: $el.scrollHeight,
      behavior: 'smooth'
    })
  })"
  overflow="auto"
  p-3
  h-75
  code={codeSnippet}
  lang="ts"
  theme="night-owl"
/>
