---
import CodeWindow from './CodeWindow.astro';
import codeSnippet from '~/assets/profile.ts?raw';
---

<CodeWindow
  x-data
  x-init="$nextTick(() => { 
    $el.scrollTo({
      top: $el.scrollHeight,
      behavior: 'smooth'
    })
  })"
  title="src/assets/profile.ts"
  h-73
  code={codeSnippet}
  lang="ts"
/>
