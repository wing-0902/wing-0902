---
import Template from '~/layouts/Template.astro';
import Header from '~/layouts/Header.astro';

import CodeWindow from '~/components/CodeWindow.astro';

import torisetsu from '~/assets/torisetsu/ja.md?raw';
---

<Template title="README - Wingのサイト" description="Wingのトリセツ．">
  <Header>
    <h1 class="title">wing.osaka/README</h1>

    <CodeWindow code={torisetsu} lang="markdown" title="README.md" wrap />
  </Header>
</Template>

<style lang="scss">
  .title {
    font-size: 16px;
    font-family: 'Fira Code Variable', monospace;
  }
</style>
