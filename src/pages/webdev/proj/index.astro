---
import Template from '~/layouts/Template.astro';
import Header from '~/layouts/Header.astro';

import { getCollection } from 'astro:content';

const allProjs = (await getCollection('projectsJa'))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())
  /* 不要なデータを削除 */
  .map((proj) => ({
    slug: proj.id,
    data: proj.data
  }));

import ProjList from '~/components/proj/list.tsx';
---

<Template title="作品 #webdev - Wingのサイト">
  <Header>
    <h1>作品</h1>

    <ProjList projects={allProjs} client:load />
  </Header>
</Template>
