---
import Template from '~/layouts/Template.astro';
import Header from '~/layouts/Header.astro';

import WebDevProfile from '~/components/WebDevProfile.astro';
import OpenGraph from '~/components/OpenGraph.astro';
---

<Template
  title="Wing's HomePage"
  description="This is Wing, a high school student in Osaka"
  lang="en"
  ogSiteName="Wing HomePage"
>
  <Header>
    <h1>Wing</h1>
    <p>A high school student in Osaka going my way, learning web development.</p>

    <WebDevProfile />

    <h2>What I can do & Hobbies</h2>

    <h3>Web Development</h3>

    <p>
      I'm developing some websites.<br />
      Of course I made this site by myself.
    </p>

    <h3>Programming</h3>

    <p>I'm also interested in other languages than JS & TS.</p>

    <ul>
      <li>Swift → studying now</li>
    </ul>

    <h3>Photography</h3>

    <p>Click the card below and visit my photo gallery!</p>

    <OpenGraph
      href="https://gallery.wing.osaka"
      ogTitle="Gallery by Wing"
      ogDescription="Wing's photo gallery"
      ogImageUrl="/image/IMG_5806.png"
    />
  </Header>
</Template>
