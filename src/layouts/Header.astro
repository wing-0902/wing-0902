---
import {useTranslations} from "~/i18n/helper";

import Logo from '~/components/Logo.astro';
import Footer from '~/layouts/Footer.astro';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const t = useTranslations(Astro);
---

<header
  class="blur-gradient-box"
  fixed
  top-0
  left-0
  p-3
  m-0
  w-full
  h-13
  flex
  justify-between
  align-center
>
  <a href="/">
    <Logo height={40} />
  </a>
  <div flex gap="2">
    <a mx-4 flex align-center href={/* otherLangUrl */}>
      <i i-hugeicons-language-skill></i>
      <span text-xl>{t("header.changeLang")}</span>
    </a>
    <a href="https://bsky.app/profile/wing.osaka" target="_blank">
      <i i-hugeicons-bluesky text-xl></i>
    </a>
    <a href="https://github.com/wing-0902" target="_blank">
      <i i-hugeicons-github text-xl></i>
    </a>
  </div>
</header>

<div mt-13 px-5 flex-1 flex justify-center min-h-0 overflow-x-hidden overflow-y-auto>
  <div w-full max-w-180>
    <slot />
    <Footer />
  </div>
</div>

<style lang="scss">
  header {
    /* 背景をぼかす */
    backdrop-filter: blur(12px);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 70%, rgba(0, 0, 0, 0) 100%);

    background-color: transparent;
    z-index: 50;
  }
</style>
