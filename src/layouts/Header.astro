---
import { useTranslations } from '~/i18n/helper';
import { I18nSwitch } from '~/components/I18nChange.tsx';

import Logo from '~/components/Logo.astro';
import Footer from '~/layouts/Footer.astro';
import I18nLink from '~/components/I18nLink.astro';

const t = useTranslations(Astro);

const currentLang = Astro.currentLocale ?? 'ja-jp';
const currentPath = Astro.url.pathname;
const locales = ['ja-jp', 'en-gb'];
---

<header
  class="blur-gradient-box"
  fixed
  top-0
  left-0
  p-3
  m-0
  w-full
  h-13
  flex
  justify-between
  align-center
>
  <I18nLink href="/">
    <Logo height={40} />
  </I18nLink>
  <div flex gap="2">
    <I18nSwitch client:load currentLang={currentLang} locales={locales} currentPath={currentPath} />
    <a href="https://bsky.app/profile/wing.osaka" target="_blank">
      <i i-hugeicons-bluesky text-xl></i>
    </a>
    <a href="https://github.com/wing-0902" target="_blank">
      <i i-hugeicons-github text-xl></i>
    </a>
  </div>
</header>

<div mt-13 px-5 flex-1 flex justify-center min-h-0 overflow-x-hidden overflow-y-auto>
  <div w-full max-w-180>
    <slot />
    <Footer />
  </div>
</div>

<style lang="scss">
  header {
    /* 背景をぼかす */
    backdrop-filter: blur(12px);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 70%, rgba(0, 0, 0, 0) 100%);

    background-color: transparent;
    z-index: 50;
  }
</style>
