---
import Logo from '~/components/Logo.astro';
import Footer from '~/layouts/Footer.astro';
---

<header p-3 w-full h-12 flex justify-between align-center>
  <Logo height={40} />
  <div flex gap="2">
    <a href="https://bsky.app/profile/wing.osaka" target="_blank">
      <i i-hugeicons-bluesky text-xl></i>
    </a>
    <a href="https://github.com/wing-0902" target="_blank">
      <i i-hugeicons-github text-xl></i>
    </a>
  </div>
</header>

<div px-5 flex-1 flex justify-center overflow="x-hidden y-scroll">
  <div min-h-full w-full max-w-180>
    <slot />
    <Footer />
  </div>
</div>
