---
import AstroLink from '~/components/AstroLink.astro';
import Logo from '~/components/Logo.astro';
import Footer from '~/layouts/Footer.astro';
import { getJaUrl } from '~/utils/handleLangs';

import { getEnUrl, getLang } from '~/utils/handleLangs';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const currentLang = getLang(canonicalURL.toString());

let otherLang = '';
let otherLangUrl = '';

if (currentLang === 'ja') {
  otherLang = 'en';
  otherLangUrl = getEnUrl(canonicalURL.toString());
} else if (currentLang === 'en') {
  otherLang = 'ja';
  otherLangUrl = getJaUrl(canonicalURL.toString());
}
---

<header
  class="blur-gradient-box"
  fixed
  top-0
  left-0
  p-3
  m-0
  w-full
  h-13
  flex
  justify-between
  align-center
>
  <AstroLink href="/">
    <Logo height={40} />
  </AstroLink>
  <div flex gap="2">
    <a mx-4 flex align-center href={otherLangUrl}>
      <i i-hugeicons-language-skill></i>
      <span text-xl>{otherLang}</span>
    </a>
    <a href="https://bsky.app/profile/wing.osaka" target="_blank">
      <i i-hugeicons-bluesky text-xl></i>
    </a>
    <a href="https://github.com/wing-0902" target="_blank">
      <i i-hugeicons-github text-xl></i>
    </a>
  </div>
</header>

<div mt-13 px-5 flex-1 flex justify-center min-h-0 overflow-x-hidden overflow-y-auto>
  <div w-full max-w-180>
    <slot />
    <Footer />
  </div>
</div>

<style lang="scss">
  header {
    /* 背景をぼかす */
    backdrop-filter: blur(12px);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 70%, rgba(0, 0, 0, 0) 100%);

    background-color: transparent;
    z-index: 50;
  }
</style>
